l.writeLine(\"pass=\" + pass)\n        basic.pause(PASS_WAIT_MS)\n    }\n\n    function sendWifiRepeated() {\n        for (let i = 0; i < SEND_REPEAT; i++) {\n            sendWifiOnce()\n        }\n    }\n\n    /**\n     * Tello-Bridge 初期化\n     *\n     * - serial.redirect(P0,P1,57600)\n     * - telloRx_server.startReceiverTelloBridge(group)\n     * - 起動時に自動で Wi-Fi設定送信（オプション）\n     */\n    //% block=\"⚠スタッフ用⚠ Tello-Bridge初期化 group %group 自動接続 %autoConnect\"\n    //% group.min=0 group.max=255\n    export function start(group: number, autoConnect: boolean = true) {\n        if (initiated) return\n        initiated = true\n\n        radio_group = group\n\n        // SSID未設定なら安全にデフォルトを入れる\n        if (ssid.length == 0) {\n            telloSuffix = \"E97455\"\n            ssid = \"TELLO-\" + telloSuffix\n        }\n\n        // serial (Bridge)\n        serial.redirect(TX_PIN, RX_PIN, BRIDGE_BAUD)\n\n        // radio受信機起動（Tello-Bridge版）\n        telloRx_server.startReceiverTelloBridge(radio_group)\n\n        log(\"start ok group=\" + group + \" ssid=\" + ssid)\n\n        // SSID末尾2文字だけ表示（あなたのUIを踏襲）\n        if (ssid.length >= 12) {\n            basic.showString(ssid.substr(10, 2))\n        }\n\n        // 起動時に自動接続する\n        if (autoConnect) {\n            basic.showIcon(IconNames.Heart)\n            sendWifiRepeated()\n            basic.showIcon(IconNames.Yes)\n        }\n    }\n\n    /**\n     * Wi-Fi設定を再送（接続が不安定なとき用）\n     */\n    //% block=\"Tello-Bridge，WiFi再接続\"\n    export function resendWifi() {\n        if (!initiated) return\n\n        basic.showIcon(IconNames.Heart)\n        sendWifiRepeated()\n        basic.showIcon(IconNames.Yes)\n\n        log(\"resend wifi done\")\n    }\n\n    /**\n     * 任意コマンドを送信する\n     * 例: \"land\", \"takeoff\", \"emergency\"\n     */\n    //% block=\"Tello-Bridgeへコマンド送信 %cmd\"\n    //% cmd.defl=\"land\"\n    export function sendCommand(cmd: string) {\n        if (!initiated) return\n\n        telloRx_server._sendToSerial(cmd)\n    }\n}\n","pxt.json":"{\n    \"name\": \"kagabitIoT_receiver\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"Grove\": \"github:seeed-studio/pxt-grove#v0.3.0\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"radioEzAck.ts\",\n        \"telloRx_server.ts\",\n        \"tello_bridge.ts\"\n    ],\n    \"testFiles\": [\n        \"test.ts\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v3.0.61\",\n        \"tag\": \"v3.0.61\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/9ff91acb8524c6a52fee90cf7194a4643c424363\",\n        \"target\": \"6.0.28\",\n        \"pxt\": \"6.0.35\",\n        \"targetId\": \"microbit\"\n    },\n    \"supportedTargets\": [\n        \"microbit\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n","test.ts":"// テストはここに来ます。このパッケージが拡張機能として使用されるときにはコンパイルされません。\n"}},{"timestamp":1793242205375,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"L:~I]HhygdJmuY2FR4x(\">radio_group</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"L:~I]HhygdJmuY2FR4x(\">radio_group</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">51</field></shadow></value><next><block type=\"tello_bridge_setTelloSuffix\"><value name=\"suffix\"><shadow type=\"text\"><field name=\"TEXT\">9BFBEE</field></shadow></value><next><block type=\"tello_bridge_setPassword\"><value name=\"password\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow></value><next><block type=\"tello_bridge_start\"><value name=\"group\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"Group\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"L:~I]HhygdJmuY2FR4x(\">radio_group</field></block></value><value name=\"autoConnect\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"device_button_event\" x=\"729\" y=\"20\"><field name=\"NAME\">Button.A</field><comment pinned=\"false\" h=\"80\" w=\"160\">Aでland</comment><statement name=\"HANDLER\"><block type=\"tello_bridge_sendCommand\"><value name=\"cmd\"><shadow type=\"text\"><field name=\"TEXT\">land</field></shadow></value><next><block type=\"device_show_leds\"><field name=\"LEDS\">`\n        # # # # # \n        . . # . . \n        # . # . # \n        . # # # . \n        . . # . .\n        `</field><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></next></block></statement></block><block type=\"device_button_event\" x=\"1105\" y=\"20\"><field name=\"NAME\">Button.AB</field><comment pinned=\"false\" h=\"80\" w=\"160\">ABでWi-Fi再送</comment><statement name=\"HANDLER\"><block type=\"tello_bridge_resendWifi\"><next><block type=\"device_show_leds\"><field name=\"LEDS\">`\n        . . . . . \n        # . . . # \n        # . # . # \n        . # . # . \n        . # . # .\n        `</field><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></next></block></statement></block><block type=\"device_button_event\" x=\"20\" y=\"466\"><field name=\"NAME\">Button.B</field><comment pinned=\"false\" h=\"80\" w=\"160\">B長押しでemergency</comment><statement name=\"HANDLER\"><block type=\"controls_repeat_ext\"><value name=\"TIMES\"><shadow type=\"math_whole_number\"><field name=\"NUM\">4</field></shadow></value><statement name=\"DO\"><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">100</field></shadow></value><next><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"device_get_button2\"><field name=\"NAME\">Button.B</field></block></value><statement name=\"DO0\"><block type=\"tello_bridge_sendCommand\"><value name=\"cmd\"><shadow type=\"text\"><field name=\"TEXT\">emergency</field></shadow></value><next><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value><next><block type=\"break_keyword\"></block></next></block></next></block></next></block></statement></block></next></block></statement></block></statement></block></xml>","main.ts":"","README.md":"\n> このページを開く [https://kawanami.github.io/kagabitiot_receiver/](https://kawanami.github.io/kagabitiot_receiver/)\n\n## 拡張機能として使用\n\nこのリポジトリは、MakeCode で **拡張機能** として追加できます。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **新しいプロジェクト** をクリックしてください\n* ギアボタンメニューの中にある **拡張機能** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_receiver** を検索してインポートします。\n\n## このプロジェクトを編集します\n\nMakeCode でこのリポジトリを編集します。\n\n* [https://makecode.microbit.org/](https://makecode.microbit.org/) を開く\n* **読み込む** をクリックし、 **URLから読み込む...** をクリックしてください\n* **https://github.com/kawanami/kagabitiot_receiver** を貼り付けてインポートをクリックしてください\n\n#### メタデータ (検索、レンダリングに使用)\n\n* for PXT/microbit\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","radioEzAck.ts":"// **使用中!!**\n// 通常のRadio通信において，簡易的なACK処理を追加する\n// Tello-Bridgeとの互換ありのため，採用\n\n// 問題点：Tello-Bridgeで利用する際は必ず3回コマンドが送信される．（ACK返答がないため）\n// Tello-Bridgeでは短期間における連続コマンド受信は無視するため，重複動作は行わない（動作確認済み）\n\nnamespace radioEzAck {\n    enum Mode {\n        None = 0,\n        Controller = 1,\n        Server = 2\n    }\n\n    let mode: Mode = Mode.None\n    let inited = false\n\n    const ACK_TEXT = \"OK\"\n    const RETRY_MAX = 3\n    let ACK_TIMEOUT_MS = 100\n    let SHOW_RX_CMD_ICON = false\n    let DEBUG = false\n\n    let waiting = false\n    let acked = false\n\n    let rxHandler: (cmd: string) => void = null\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[radioEzAck] \" + s)\n    }\n    export function setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[radioEzAck] DEBUG ON\")\n    }\n    export function setAckTimeout(ms: number) {\n        ACK_TIMEOUT_MS = ms\n        log(\"ACK_TIMEOUT_MS=\" + ms)\n    }\n\n    function initIfNeeded() {\n        if (inited) return\n        inited = true\n        radio.onReceivedString(onRx)\n        log(\"init ok\")\n    }\n\n    function onRx(msg: string) {\n        // ACK受信\n        if (msg == ACK_TEXT) {\n            if (waiting) {\n                acked = true\n                log(\"RX ACK (OK) -> matched\")\n            } else {\n                log(\"RX ACK (OK) -> ignored (not waiting)\")\n            }\n            return\n        }\n\n        if (mode == Mode.Server) {\n            const cmd = \"\" + msg // 念のためコピー\n            log(\"RX CMD: \" + cmd)\n\n            // ★受信イベント内で重いことはしない：handlerもACK送信も外へ\n            control.inBackground(() => {\n                // handler（Tello-Bridge互換）\n                if (rxHandler) rxHandler(cmd)\n\n                // ACK返信（受信イベント外）\n                basic.pause(10)\n                radio.sendString(ACK_TEXT)\n                log(\"TX ACK (OK)\")\n\n                if (SHOW_RX_CMD_ICON) {\n                    basic.showIcon(IconNames.Target)\n                    basic.pause((300))\n                    basic.clearScreen()\n                }\n            })\n            return\n        }\n\n        // NOTE: サーバ → コントローラ通信実装時に利用\n        // TODO: 実装を完了させる\n        if (mode == Mode.Controller) {\n        }\n\n        log(\"RX ignored (mode=\" + mode + \" msg=\" + msg + \")\")\n    }\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode=Controller\")\n    }\n\n    export function _setModeServer(handler: (cmd: string) => void, showRxIcon: boolean = false) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        SHOW_RX_CMD_ICON = showRxIcon\n        log(\"mode=Server showRxIcon=\" + showRxIcon)\n    }\n\n    export function _sendWithAck(cmd: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        waiting = true\n        acked = false\n\n        log(\"SEND start cmd=\" + cmd)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX cmd try=\" + (i + 1))\n            radio.sendString(cmd)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success\")\n                    return true\n                }\n                basic.pause(5)\n            }\n            log(\"TIMEOUT (no OK)\")\n        }\n\n        waiting = false\n        log(\"SEND failed\")\n        return false\n    }\n}\n","telloRx_server.ts":"//% advanced=true\n//% block=\"⚠スタッフ用⚠ Tello受信機ブロック\"\n//% group.min=0 group.max=255\nnamespace telloRx_server {\n    let started = false\n\n    let hasPending = false\n    let pending = \"\"\n\n    // 外部クラスからシリアル送信行う用（tello_bridgeクラスで利用中）\n    export function _sendToSerial(s: string) {\n        pending = \"\" + s\n        hasPending = true\n    }\n\n    function startSerialWorkerOnce() {\n        control.inBackground(() => {\n            while (true) {\n                if (hasPending) {\n                    const s = pending\n                    hasPending = false\n\n                    serial.writeLine(s)\n                }\n                basic.pause(1)\n            }\n        })\n    }\n\n    function _startReceiverCommon(group: number, showIcon: boolean) {\n        if (started) return\n        started = true\n\n        radio.setGroup(group)\n        radio.setTransmitPower(7)\n        radio.setFrequencyBand(group % 84)\n\n        startSerialWorkerOnce()\n\n        radioEzAck._setModeServer((payload: string) => {\n            pending = \"\" + payload\n            hasPending = true\n        }, showIcon)\n    }\n\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示無） %group\"\n    //% group.min=0 group.max=255\n    export function startReceiverPcServerNoIcon(group: number) {\n        _startReceiverCommon(group, false)\n    }\n\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 （受信表示有） %group\"\n    //% group.min=0 group.max=255\n    export function startReceiverPcServer(group: number) {\n        _startReceiverCommon(group, true)\n    }\n}","tello_bridge.ts":"/**\n * tello_bridge.ts\n *\n * Tello-Bridge 用ユーティリティ\n *\n * - Tello機体番号（SSID末尾）をセット\n * - serial (P0/P1, 57600) を初期化\n * - radio受信 → serial転送 (telloRx_server.startReceiverTelloBridge)\n * - ss= / pass= を2回送信して確実化\n */\n\nnamespace tello_bridge {\n    let initiated = false\n\n    // ---- 設定値 ----\n    let radio_group = 0\n\n    // Tello Wi-Fi情報\n    let telloSuffix = \"\"   // 例: \"E97455\"\n    let ssid = \"\"          // \"TELLO-\" + suffix\n    let pass = \"\"          // 通常は空\n\n    // シリアル設定（Tello-Bridge仕様）\n    const BRIDGE_BAUD = BaudRate.BaudRate57600\n    const TX_PIN = SerialPin.P0\n    const RX_PIN = SerialPin.P1\n\n    // Wi-Fi送信安定化用（あなたの経験則）\n    const SEND_REPEAT = 2\n    const SS_WAIT_MS = 1000\n    const PASS_WAIT_MS = 1500\n\n    let DEBUG = false\n\n    function log(s: string) {\n        if (DEBUG) serial.writeLine(\"[tello_bridge] \" + s)\n    }\n\n    //% block=\"Tello-Bridge デバッグ %enabled\"\n    export function setDebug(enabled: boolean) {\n        DEBUG = enabled\n        if (DEBUG) serial.writeLine(\"[tello_bridge] DEBUG ON\")\n    }\n\n    /**\n     * Tello機体番号（SSID末尾）を設定する\n     * 例: \"E97455\"\n     */\n    //% block=\"Tello機体番号を設定 %suffix\"\n    //% suffix.defl=\"E97455\"\n    export function setTelloSuffix(suffix: string) {\n        telloSuffix = \"\" + suffix\n        ssid = \"TELLO-\" + telloSuffix\n        log(\"set suffix=\" + telloSuffix + \" ssid=\" + ssid)\n    }\n\n    /**\n     * Telloパスワードを設定する（通常は空文字）\n     */\n    //% block=\"Telloパスワードを設定 %password\"\n    //% password.defl=\"\"\n    export function setPassword(password: string) {\n        pass = \"\" + password\n        log(\"set pass=\" + pass)\n    }\n\n    /**\n     * 現在のSSIDを取得（デバッグ用）\n     */\n    //% block=\"現在のTello SSID\"\n    export function getSsid(): string {\n        return ssid\n    }\n\n    function sendWifiOnce() {\n        if (ssid.length == 0) {\n            log(\"SSID is empty -> ignored\")\n            return\n        }\n\n        serial.writeLine(\"ss=\" + ssid)\n        basic.pause(SS_WAIT_MS)\n\n        serial.writeLine(\"pass=\" + pass)\n        basic.pause(PASS_WAIT_MS)\n    }\n\n    function sendWifiRepeated() {\n        for (let i = 0; i < SEND_REPEAT; i++) {\n            sendWifiOnce()\n        }\n    }\n\n    /**\n     * Tello-Bridge 初期化\n     *\n     * - serial.redirect(P0,P1,57600)\n     * - telloRx_server.startReceiverTelloBridge(group)\n     * - 起動時に自動で Wi-Fi設定送信（オプション）\n     */\n    //% block=\"⚠スタッフ用⚠ Tello-Bridge初期化 group %group 自動接続 %autoConnect\"\n    //% group.min=0 group.max=255\n    export function start(group: number, autoConnect: boolean = true) {\n        if (initiated) return\n        initiated = true\n\n        radio_group = group\n\n        // SSID未設定なら安全にデフォルトを入れる\n        if (ssid.length == 0) {\n            telloSuffix = \"E97455\"\n            ssid = \"TELLO-\" + telloSuffix\n        }\n\n        // serial (Bridge)\n        serial.redirect(TX_PIN, RX_PIN, BRIDGE_BAUD)\n\n        // radio受信機起動（Tello-Bridge版）\n        telloRx_server.startReceiverPcServer(radio_group)\n\n        log(\"start ok group=\" + group + \" ssid=\" + ssid)\n\n        // SSID末尾2文字だけ表示（あなたのUIを踏襲）\n        if (ssid.length >= 12) {\n            basic.showString(ssid.substr(10, 2))\n        }\n\n        // 起動時に自動接続する\n        if (autoConnect) {\n            basic.showIcon(IconNames.Heart)\n            sendWifiRepeated()\n            basic.showIcon(IconNames.Yes)\n        }\n    }\n\n    /**\n     * Wi-Fi設定を再送（接続が不安定なとき用）\n     */\n    //% block=\"Tello-Bridge，WiFi再接続\"\n    export function resendWifi() {\n        if (!initiated) return\n\n        basic.showIcon(IconNames.Heart)\n        sendWifiRepeated()\n        basic.showIcon(IconNames.Yes)\n\n        log(\"resend wifi done\")\n    }\n\n    /**\n     * 任意コマンドを送信する\n     * 例: \"land\", \"takeoff\", \"emergency\"\n     */\n    //% block=\"Tello-Bridgeへコマンド送信 %cmd\"\n    //% cmd.defl=\"land\"\n    export function sendCommand(cmd: string) {\n        if (!initiated) return\n\n        telloRx_server._sendToSerial(cmd)\n    }\n}\n","pxt.json":"{\n    \"name\": \"TelloBridge_receiver2026\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"Grove\": \"github:seeed-studio/pxt-grove#v0.3.0\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"radioEzAck.ts\",\n        \"telloRx_server.ts\",\n        \"tello_bridge.ts\"\n    ],\n    \"testFiles\": [\n        \"test.ts\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v3.0.61\",\n        \"tag\": \"v3.0.61\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/9ff91acb8524c6a52fee90cf7194a4643c424363\",\n        \"target\": \"6.0.28\",\n        \"pxt\": \"6.0.35\",\n        \"targetId\": \"microbit\"\n    },\n    \"supportedTargets\": [\n        \"microbit\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n","test.ts":"// テス