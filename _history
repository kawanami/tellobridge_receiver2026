 matched\")\n            } else {\n                log(\"RX ACK (OK) -> ignored (not waiting)\")\n            }\n            return\n        }\n\n        if (mode == Mode.Server) {\n            const cmd = \"\" + msg // 念のためコピー\n            log(\"RX CMD: \" + cmd)\n\n            // ★受信イベント内で重いことはしない：handlerもACK送信も外へ\n            control.inBackground(() => {\n                // handler（Tello-Bridge互換）\n                if (rxHandler) rxHandler(cmd)\n\n                // ACK返信（受信イベント外）\n                basic.pause(10)\n                radio.sendString(ACK_TEXT)\n                log(\"TX ACK (OK)\")\n\n                if (SHOW_RX_CMD_ICON) {\n                    basic.showIcon(IconNames.Target)\n                    basic.pause((300))\n                    basic.clearScreen()\n                }\n            })\n            return\n        }\n\n        // NOTE: サーバ → コントローラ通信実装時に利用\n        // TODO: 実装を完了させる\n        if (mode == Mode.Controller) {\n        }\n\n        log(\"RX ignored (mode=\" + mode + \" msg=\" + msg + \")\")\n    }\n\n    export function _setModeController() {\n        initIfNeeded()\n        mode = Mode.Controller\n        rxHandler = null\n        log(\"mode=Controller\")\n    }\n\n    export function _setModeServer(handler: (cmd: string) => void, showRxIcon: boolean = false) {\n        initIfNeeded()\n        mode = Mode.Server\n        rxHandler = handler\n        SHOW_RX_CMD_ICON = showRxIcon\n        log(\"mode=Server showRxIcon=\" + showRxIcon)\n    }\n\n    export function _sendWithAck(cmd: string): boolean {\n        initIfNeeded()\n\n        if (waiting) {\n            log(\"SEND rejected (already waiting)\")\n            return false\n        }\n\n        waiting = true\n        acked = false\n\n        log(\"SEND start cmd=\" + cmd)\n\n        for (let i = 0; i < RETRY_MAX; i++) {\n            log(\"TX cmd try=\" + (i + 1))\n            radio.sendString(cmd)\n\n            const t0 = control.millis()\n            while (control.millis() - t0 < ACK_TIMEOUT_MS) {\n                if (acked) {\n                    waiting = false\n                    log(\"SEND success\")\n                    return true\n                }\n                basic.pause(5)\n            }\n            log(\"TIMEOUT (no OK)\")\n        }\n\n        waiting = false\n        log(\"SEND failed\")\n        return false\n    }\n}\n","telloRx_server.ts":"//% advanced=true\n//% block=\"⚠スタッフ用⚠ Tello受信機初期化\"\n//% group.min=0 group.max=255\nnamespace telloRx_server {\n    let started = false\n\n    let hasPending = false\n    let pending = \"\"\n\n    // 外部クラスからシリアル送信行う用（tello_bridgeクラスで利用中）\n    export function _sendToSerial(s: string) {\n        pending = \"\" + s\n        hasPending = true\n    }\n\n    function startSerialWorkerOnce() {\n        control.inBackground(() => {\n            while (true) {\n                if (hasPending) {\n                    const s = pending\n                    hasPending = false\n\n                    serial.writeLine(s)\n                }\n                basic.pause(1)\n            }\n        })\n    }\n\n    function _startReceiverCommon(group: number, showIcon: boolean) {\n        if (started) return\n        started = true\n\n        radio.setGroup(group)\n        radio.setTransmitPower(7)\n        radio.setFrequencyBand(group % 84)\n\n        startSerialWorkerOnce()\n\n        radioEzAck._setModeServer((payload: string) => {\n            pending = \"\" + payload\n            hasPending = true\n        }, showIcon)\n    }\n\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】PCサーバー受信機 初期化\"\n    //% group.min=0 group.max=255\n    export function startReceiverPcServer(group: number) {\n        _startReceiverCommon(group, false)\n    }\n\n    //% block=\"⚠スタッフ用⚠ 【最初だけ】Tello-Bridge受信機 初期化\"\n    //% group.min=0 group.max=255\n    export function startReceiverTelloBridge(group: number) {\n        _startReceiverCommon(group, true)\n    }\n}","tello_bridge.ts":"/**\n * tello_bridge.ts\n *\n * Tello-Bridge 用ユーティリティ\n *